{
  "autoExpandSnippets": true,
  "defaultEngineKeyword": "g",
  "engines": [
    {
      "keyword": "g",
      "name": "Google",
      "urlTemplate": "https://www.google.com/search?q={query}"
    },
    {
      "keyword": "bing",
      "name": "Bing",
      "urlTemplate": "https://www.bing.com/search?q={query}"
    },
    {
      "keyword": "gh",
      "name": "GitHub",
      "urlTemplate": "https://github.com/search?q={query}"
    },
    {
      "keyword": "arxiv",
      "name": "arXiv",
      "urlTemplate": "https://arxiv.org/search/?query={query}&searchtype=all"
    },
    {
      "keyword": "inspire",
      "name": "INSPIRE-HEP",
      "urlTemplate": "https://inspirehep.net/literature?q={query}"
    },
    {
      "keyword": "scholar",
      "name": "Google Scholar",
      "urlTemplate": "https://scholar.google.com/scholar?q={query}"
    },
    {
      "keyword": "wiki",
      "name": "维基百科",
      "urlTemplate": "https://zh.wikipedia.org/w/index.php?search={query}"
    },
    {
      "keyword": "gzt",
      "name": "本地看板",
      "urlTemplate": "http://127.0.0.1:<port>/#home"
    },
    {
      "keyword": "ia",
      "name": "INSPIRE 作者",
      "urlTemplate": "https://inspirehep.net/authors?q={query}"
    }
  ],
  "hotKey": "option+space",
  "maxResults": 12,
  "searchFolders": [
    "~/Desktop",
    "~/Documents",
    "~/Downloads",
    "~/Library/Mathematica"
  ],
  "searchHomeFolder": true,
  "showInDock": true,
  "snippetInjection": "type",
  "snippets": [
    {
      "content": "${cursor}$",
      "keyword": "\\$",
      "name": "$"
    },
    {
      "content": "\\mathrm{d}",
      "keyword": "\\D ",
      "name": "\\D"
    },
    {
      "content": "Poincar\\'e",
      "keyword": "\\Poincare",
      "name": "Poincare"
    },
    {
      "content": "\\mathrm{T}\\overline{\\mathrm{T}}",
      "keyword": "\\TTbar",
      "name": "TTbar"
    },
    {
      "content": "\\left|{cursor}\\right|",
      "keyword": "\\abs",
      "name": "absolute"
    },
    {
      "content": "\\begin{aligned}\n{cursor}\n\\end{aligned}",
      "keyword": "\\aed",
      "name": "aligned"
    },
    {
      "content": "\\begin{align}\n{cursor}\n\\end{align}",
